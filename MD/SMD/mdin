Production
 &cntrl
  imin       = 0        ! No minimization but molecular dynamics
  irest      = 0        ! Simulation is not restarted from a previous simulation
  ntx        = 1        ! Coordinates and box information is read from a previous simulation

  ntb        = 1        ! Periodic Boundary Conditions in the NVT ensemble 

  ntp        = 0        ! Not scaling of pressure
!  barostat   = 1        ! Berendsen barostat
!  pres0      = 1.0      ! Pressure in bars
!  taup       = 2.0      ! Relaxation time in ps

  cut        = 12.0     ! Cutoff for Lennard-Jones and real-space Ewald interactions
  ntc        = 2        ! Bonds involving hydrogen atoms are constrained with SHAKE
  ntf        = 2        ! Bond interactions involving hydrogen are not computed

  tempi      = 300.0    ! Initial temperature
  temp0      = 300.0    ! Final temperature
  ntt        = 3        ! Langevin thermostat
  gamma_ln   = 1.0      ! Collision frequency in ps-1

  nstlim     = 150000000  ! Number of time steps
  dt         = 0.002    ! Time step in ps

  ntpr       = 4000     ! Energy is printed every N steps
  ntwx       = 10000     ! Trajectory is printed every N steps
  ntwr       = 40000    ! Restart file is printed every N steps
  ntxo       = 2        ! Binary format for final coordinates, velocities and box size
  ioutfm     = 1        ! Binary format for trajectory (xyz) file
  iwrap      = 1        ! Solvent molecules are wrapped into the primary box

  infe = 1
! nscm = 100    ! Removal of motion of the CM each nscm steps
 &end

 &smd
  output_file = 'smd_out.dat'
  output_freq = 2000
  cv_file = 'colvar.in'
 &end

