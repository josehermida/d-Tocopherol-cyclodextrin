#MD CD metadynamics
!MD  GFN2-xTB Conv nososcf
%pal nprocs 16
end
%MaxCore 3000
%md
  timestep 0.5_fs
  randomize
  initvel 300_K no_overwrite
  cell sphere 0. 0. 0. 10.0_A
  scflog last
  thermostat NHC 300_K Timecon 50.0_fs
  dump position stride 5 filename "trajectory.xyz"
# manage_colvar define 1 distance Group 169 161 162 168 171 172 Group 28 29 20 31 32 33 34
# metadynamics colvar 1 range 0.5 12.0 20
# Metadynamics HillSpawn 40 0.5 0.5 Store 2000
  restart ifexists
  run 1100000 #steplimit 0.1_A
end
